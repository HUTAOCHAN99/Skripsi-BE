generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      Role       @default(MAHASISWA)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dosen     Dosen?
  mahasiswa Mahasiswa?
}

model Mahasiswa {
  id             String           @id @default(cuid())
  userId         String           @unique
  nama           String
  nim            String           @unique
  angkatan       Int
  noTelp         String?
  alamat         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  jadwalSidang   JadwalSidang?
  logBimbingan   LogBimbingan[]
  user           User             @relation(fields: [userId], references: [id])
  pengajuanJudul PengajuanJudul[]
  berkas         Berkas[]
}

model Dosen {
  id                      String           @id @default(cuid())
  userId                  String           @unique
  nama                    String
  nip                     String           @unique
  bidangKeahlian          String
  noTelp                  String?
  kuota                   Int              @default(5)
  terisi                  Int              @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  user                    User             @relation(fields: [userId], references: [id])
  jadwalSebagaiPembimbing JadwalSidang[]   @relation("pembimbing")
  jadwalSebagaiPenguji    JadwalSidang[]   @relation("penguji")
  logBimbingan            LogBimbingan[]
  pembimbing              PengajuanJudul[]
}

model PengajuanJudul {
  id                String          @id @default(cuid())
  mahasiswaId       String
  judul             String
  abstrak           String?
  dosenPembimbingId String?
  status            StatusPengajuan @default(PENDING)
  catatan           String?
  tglAjukan         DateTime        @default(now())
  tglApproved       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  dosenPembimbing   Dosen?          @relation(fields: [dosenPembimbingId], references: [id])
  mahasiswa         Mahasiswa       @relation(fields: [mahasiswaId], references: [id])
}

model LogBimbingan {
  id          String          @id @default(cuid())
  mahasiswaId String
  dosenId     String
  pertemuanKe Int
  tanggal     DateTime
  topik       String
  catatan     String
  status      StatusBimbingan @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  dosen       Dosen           @relation(fields: [dosenId], references: [id])
  mahasiswa   Mahasiswa       @relation(fields: [mahasiswaId], references: [id])
}

model JadwalSidang {
  id                String       @id @default(cuid())
  mahasiswaId       String       @unique
  dosenPembimbingId String
  dosenPengujiId    String
  tanggal           DateTime
  jam               String
  ruang             String
  status            StatusSidang @default(SCHEDULED)
  hasil             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  dosenPembimbing   Dosen        @relation("pembimbing", fields: [dosenPembimbingId], references: [id])
  dosenPenguji      Dosen        @relation("penguji", fields: [dosenPengujiId], references: [id])
  mahasiswa         Mahasiswa    @relation(fields: [mahasiswaId], references: [id])
}

enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

enum StatusPengajuan {
  PENDING
  APPROVED
  REJECTED
}

enum StatusBimbingan {
  PENDING
  APPROVED
  REJECTED
}

enum StatusSidang {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Berkas {
  id          String   @id @default(cuid())
  mahasiswaId String
  judul       String
  jenis       String   // 'proposal', 'bab1', 'bab2', 'full_skripsi', 'revisi'
  fileName    String   // Nama asli file
  filePath    String   // Path di server
  fileSize    Int      // Ukuran dalam bytes
  mimeType    String   // application/pdf, application/msword, dll
  status      StatusBerkas @default(PENDING)
  catatan     String?
  tglUpload   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
}

enum StatusBerkas {
  PENDING
  APPROVED
  REJECTED
}